{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MEYAFORGE",
  "version": "0.1.0",
  "identifier": "dev.meyaforge.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "MEYAFORGE",
        "width": 1280,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 640,
        "decorations": false,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
